TOKEN=change-me
BROWSERLESS_TOKEN=change-me
CONCURRENT=1
QUEUED=20
TIMEOUT=300000
DEFAULT_TIMEOUT=300000
MAX_MEMORY_PERCENT=95
MAX_CPU_PERCENT=95
PORT=3000
PMX_BROWSERLESS_MODE=auto
# Set PMX_BROWSERLESS_MODE=next-api for Firebase Studio/Z.ai style sandboxes
# where standalone processes are killed after 60-90 seconds.
