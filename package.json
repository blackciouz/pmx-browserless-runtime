{
  "name": "pmx-browserless-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "PMX Browserless runtime with Docker Browserless and Playwright-lite fallback.",
  "scripts": {
    "start": "node pmx-browserless-lite.cjs",
    "lite": "node pmx-browserless-lite.cjs",
    "next-api": "next dev -H 0.0.0.0 -p ${PORT:-3000}",
    "next-build": "next build",
    "next-start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "probe": "node scripts/probe-runtime.cjs"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "playwright": "^1.57.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.7.0"
  }
}
